{
  "version": 2,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*\\.html)",
      "headers": { "Cache-Control": "no-cache, must-revalidate" },
      "continue": true
    },
    {
      "src": "/(.*\\.html)",
      "dest": "/$1"
    },
    { "handle": "filesystem" },
    {
      "src": "/",
      "dest": "/lamsa-auth.html"
    }
  ]
}
